# ImmuneBuilder SDAA 环境变量模板
#
# 用法：cp .env.sdaa.example .env.sdaa 后按本机实际情况修改。
# 真实的 .env.sdaa 已被 .gitignore 排除（含主机相关路径与 UID）。

# ---- 宿主机 UID/GID：容器以此身份运行，避免产出 root 属主文件 ----
# 本机查询： id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# ---- 镜像与容器 ----
IMAGE_NAME=immunebuilder-sdaa:torch2.12.0-sdaa3.2.1-py312
CONTAINER_NAME=immunebuilder-sdaa
COMPOSE_PROJECT_NAME=immunebuilder-sdaa

# ---- 基础镜像 ----
# 本地构建产物，RepoDigests 为空 → 只能按 tag 引用；
# Image ID 由 scripts/build-image.sh 在构建前强制校验（等价的 digest 固定）。
BASE_IMAGE=lasermpnn-sdaa321-loong:torch2.12.0-sdaa3.2.1-py312
BASE_IMAGE_ID=sha256:3e425da47a74a03b589f8e1c18a67dcb90c8bcbde977cc1df09fa01209b7a524

# ---- SDAA 设备 ----
# 宿主 /dev/tcaicard0 映射为容器内同名节点（注意不是 /dev/teco*）
SDAA_DEVICE_NODE=/dev/tcaicard0
SDAA_VISIBLE_DEVICES=0

# ---- 神经网络（torch）设备：auto | cpu | sdaa | cuda ----
# auto 顺序 CUDA -> SDAA -> CPU；龙芯上解析为 sdaa。
IMMUNEBUILDER_DEVICE=auto

# ---- OpenMM 精修平台：auto | CPU | SDAA | Reference ----
# auto 顺序（见 device_utils.resolve_openmm_platform）：
#     CUDA -> CPU -> SDAA -> Reference
# 即 x86_64+NVIDIA 节点仍用 CUDA（与上游一致）；龙芯节点没有 CUDA 平台，默认落在 CPU。
#
# **默认 CPU**：实测当前 OpenMM 适配在三个官方用例上，最大体系（antibody，3483 原子）
# 相对龙芯 CPU 32 线程并无优势；且 CPU 平台不依赖加速器、更稳定、更可移植。
# SDAA 作为**可选加速路径**，需显式开启（见下方 IMMUNEBUILDER_OPENMM_PROPERTIES）。
IMMUNEBUILDER_OPENMM_PLATFORM=CPU

# ---- 精修线程数 ----
# CPU 平台以 OPENMM_CPU_THREADS 作为 Threads 属性的默认值，n_threads<=0 时也生效。
# 实测本机（4 NUMA 节点 / 128 逻辑核）32 线程优于 64 与 128。
OPENMM_CPU_THREADS=32

# ---- SDAA 平台属性（仅当 IMMUNEBUILDER_OPENMM_PLATFORM=SDAA 时可用）----
# 默认留空。CPU / Reference / CUDA 平台都不接受 SDAA 专有属性，
# 若本变量非空而平台被切成非 SDAA，OpenMM 会抛 Illegal property name。
#
# 启用 SDAA 精修（可选）：
#     IMMUNEBUILDER_OPENMM_PLATFORM=SDAA
#     IMMUNEBUILDER_OPENMM_PROPERTIES=UseCpuDirect=true,Precision=mixed
#
# 实测（三用例 total 中位数之和，龙芯同机）：
#     SDAA 默认                        81.4 s
#     + UseCpuDirect                   58.8 s
#     + UseCpuDirect + Precision=mixed 55.0 s
#     龙芯 CPU 32 线程（对照）          60.7 s
# UseCpuDirect 是主要杠杆（-28%，三用例方向一致）；
# Precision=mixed 单独开启无收益，只在配合 UseCpuDirect 时有效。
# 精度：各配置跨臂 CA-RMSD 与同机重复运行的自身差异同量级 ⇒ 不改变精度。
IMMUNEBUILDER_OPENMM_PROPERTIES=

# ---- 复用的 OpenMM 构建（只读挂载，不在本仓库内） ----
# 需要 OPENMM_BUILD_CPU_LIB=ON 的构建：平台列表应为 ['Reference','CPU','SDAA']，
# 且 libOpenMMSDAA.so 的 NEEDED 含 libOpenMMCPU.so（USE_CPU_DIRECT=1）。
# 绑定与库必须同源——两项一起换。
# 关键产物 sha256 见 locks/openmm-and-sdaa-deps.sha256。
OPENMM_INSTALL=<WORKSPACE>/Openmm-sdaa-v2/work-v2/install
OPENMM_SITE_PACKAGES=<WORKSPACE>/Openmm-sdaa-v2/work-v2/venv/lib/python3.12/site-packages
OPENMM_VERSION_TAG=v2

# ---- HMMER 源码包 sha256（构建时校验；由 scripts/download-deps.sh 回填） ----
HMMER_SHA256=611c17c2e94fc7ea69cc9303d58f0e7908ec627b987ef502c104a1224130d8c3
